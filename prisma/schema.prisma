// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @unique @default(autoincrement())
  name        String
  lastName    String
  email       String    @unique
  password    String
  tasks       Task[]    @relation("UserTasksCreated")
  tasksUpdated Task[]   @relation("UserTasksUpdated")
  tasksDisabled Task[]  @relation("UserTasksDisabled")
  disabled    Boolean   @default(false)
  disabled_at DateTime?
  updated_by  Int?
  disabled_by Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
}

model Task {
  id           Int       @id @unique @default(autoincrement())
  title        String
  content      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt
  status       String    @default("PENDING")
  disabled     Boolean   @default(false)
  disabled_at  DateTime?
  
  createdBy    Int       
  creator      User      @relation("UserTasksCreated", fields: [createdBy], references: [id], onDelete: Cascade)

  updatedBy    Int?    
  updater      User?     @relation("UserTasksUpdated", fields: [updatedBy], references: [id], onDelete: SetNull)

  disabledBy   Int?      
  disabler     User?     @relation("UserTasksDisabled", fields: [disabledBy], references: [id], onDelete: SetNull)
}


